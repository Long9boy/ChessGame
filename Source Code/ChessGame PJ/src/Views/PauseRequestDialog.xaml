<Window x:Class="ChessGame_PJ.Views.PauseRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xin Tạm Dừng Trận Đấu" Height="340" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1C2E">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⏸️ XIN TẠM DỪNG TRẬN ĐẤU"
                   FontSize="18" FontWeight="ExtraBold"
                   Foreground="#FFD700" HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="#FFD700" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Duration options -->
        <Border Grid.Row="1" Background="#2A2744" CornerRadius="12" Margin="0,14,0,14" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Chọn khoảng thời gian bạn muốn tạm dừng:"
                           Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                <RadioButton x:Name="rb1m" IsChecked="True" GroupName="PauseGroup" Margin="0,3,0,3" Cursor="Hand">
                    <RadioButton.Content>
                        <TextBlock Text="⏱️ 1 Phút" Foreground="#00E5FF" FontWeight="Bold" FontSize="14"/>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="rb2m" GroupName="PauseGroup" Margin="0,3,0,3" Cursor="Hand">
                    <RadioButton.Content>
                        <TextBlock Text="⏱️ 2 Phút" Foreground="#00E676" FontWeight="Bold" FontSize="14"/>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="rb3m" GroupName="PauseGroup" Margin="0,3,0,3" Cursor="Hand">
                    <RadioButton.Content>
                        <TextBlock Text="⏱️ 3 Phút" Foreground="#FFD700" FontWeight="Bold" FontSize="14"/>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="rb5m" GroupName="PauseGroup" Margin="0,3,0,3" Cursor="Hand">
                    <RadioButton.Content>
                        <TextBlock Text="⏱️ 5 Phút" Foreground="#FF5252" FontWeight="Bold" FontSize="14"/>
                    </RadioButton.Content>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="2">
            <Button Content="Huỷ" Width="90" Height="36"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#54507A" Foreground="White"
                    Click="BtnCancel_Click"/>
            <Button Content="Gửi Yêu Cầu" Width="140" Height="36"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#FFD700" Foreground="#121212" FontWeight="Bold" FontSize="14"
                    Click="BtnSend_Click"/>
        </DockPanel>
    </Grid>
</Window>
