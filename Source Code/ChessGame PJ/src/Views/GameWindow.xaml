<Window x:Class="ChessGame_PJ.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cờ Vua Vip Pro - Bàn Cờ" Height="820" Width="1160"
        MinHeight="720" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/assets/app_icon.png"
        Background="#1E1C2E"
        KeyDown="GameWindow_KeyDown">
    <Window.Resources>
        <Style x:Key="BoardCoordinateStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4AF37"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern ScrollBar Style for Move History -->
        <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="#54507A" CornerRadius="4" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#00E676"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#161424">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="#1E1C2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Player Info Cards with Digital Bank Clocks -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Player 1 Card (White) - Fixed Height to completely eliminate layout jitter -->
            <Border x:Name="cardP1" Grid.Column="0" Background="#2A2744" CornerRadius="12" Padding="12,8,12,8"
                    Height="102" BorderThickness="2" BorderBrush="#54507A" Cursor="Hand"
                    ToolTip="Nhấp chuột phải để xem thông tin người chơi"
                    MouseRightButtonUp="CardP1_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border x:Name="avatarP1Border" Grid.Column="0" Width="52" Height="52" CornerRadius="10" 
                            Background="#373456" Margin="0,0,10,0" BorderThickness="2" BorderBrush="#54507A"
                            VerticalAlignment="Center">
                        <Image x:Name="imgAvatar1" Stretch="Uniform" Margin="2"/>
                    </Border>

                    <!-- Info, Clock & Captured Pieces Row -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Row: Name + Color on left, Clock on right -->
                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="#181624" CornerRadius="8" Padding="7,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock x:Name="lblClockP1" Text="10:00" Foreground="#00E5FF" FontWeight="ExtraBold" FontSize="15"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtName1" Text="Người chơi 1" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Image x:Name="imgCardPiece1" Width="18" Height="18" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="lblCardColor1" Text="Quân Trắng" Foreground="#FFD700" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Bottom Row: Captured Pieces full width -->
                        <StackPanel x:Name="pnlCaptured1" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Height="28" Margin="0,4,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Center Status & Turn Timer -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="lblRoomInfo" Text="Phòng: ------" Foreground="White" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="lblTurnTimer" Text="⏳ Đang đợi người chơi..." Foreground="#A5A2C2" FontSize="12" FontWeight="Normal" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="btnInviteFriendInRoom" Content="👥 Mời Bạn Bè" Margin="0,6,0,0" Height="26" Width="120"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#00E676" Foreground="#121212" FontWeight="Bold" FontSize="11"
                        Visibility="Collapsed" Click="BtnInviteFriendInRoom_Click"/>
            </StackPanel>

            <!-- Player 2 Card (Black) - Fixed Height to completely eliminate layout jitter -->
            <Border x:Name="cardP2" Grid.Column="2" Background="#2A2744" CornerRadius="12" Padding="12,8,12,8"
                    Height="102" BorderThickness="2" BorderBrush="#54507A" Cursor="Hand"
                    ToolTip="Nhấp chuột phải để xem thông tin người chơi"
                    MouseRightButtonUp="CardP2_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border x:Name="avatarP2Border" Grid.Column="0" Width="52" Height="52" CornerRadius="10" 
                            Background="#373456" Margin="0,0,10,0" BorderThickness="2" BorderBrush="#54507A"
                            VerticalAlignment="Center">
                        <Image x:Name="imgAvatar2" Stretch="Uniform" Margin="2"/>
                    </Border>

                    <!-- Info, Clock & Captured Pieces Row -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Row: Name + Color on left, Clock on right -->
                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="#181624" CornerRadius="8" Padding="7,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock x:Name="lblClockP2" Text="10:00" Foreground="#00E5FF" FontWeight="ExtraBold" FontSize="15"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtName2" Text="Đang đợi..." Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Image x:Name="imgCardPiece2" Width="18" Height="18" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="lblCardColor2" Text="Quân Đen" Foreground="#A5A2C2" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Bottom Row: Captured Pieces full width -->
                        <StackPanel x:Name="pnlCaptured2" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Height="28" Margin="0,4,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Center Row: Left Chessboard, Right Move History Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Chessboard Container with Coordinates & Pause Overlay -->
            <Grid Grid.Column="0">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                    <Grid Width="624" Height="590">
                        <!-- Outer Frame Border -->
                        <Border Background="#161424" CornerRadius="10" BorderBrush="#3D385E" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>

                        <!-- Board Inner Layout Grid (Eval Bar + 22px ranks/files border + 560px board + 8px margin) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="560"/>
                                <RowDefinition Height="8"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="colEvalBar" Width="Auto"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="560"/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>

                            <!-- Leftmost: Stockfish Evaluation Bar (Offline vs Bot Mode) -->
                            <Grid x:Name="pnlEvalBar" Grid.Row="1" Grid.Column="0" Width="26" Height="560" Margin="4,0,4,0" Visibility="Collapsed"
                                  ToolTip="Thanh đánh giá điểm thế trận của Stockfish">
                                <Border Background="#262421" CornerRadius="4" BorderBrush="#54507A" BorderThickness="1.5" ClipToBounds="True">
                                    <Grid>
                                        <!-- White advantage fill -->
                                        <Border x:Name="barEvalWhite" Background="#ECECD0" VerticalAlignment="Bottom" Height="280"/>

                                        <!-- Score Pill -->
                                        <Border x:Name="badgeEvalScore" Background="#D9161424" CornerRadius="3" Padding="2,1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1">
                                            <TextBlock x:Name="lblEvalScore" Text="0.0" Foreground="#00E5FF"
                                                       FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Top File Labels: A to H (ONLY on Top) -->
                            <UniformGrid x:Name="gridFileLabels" Grid.Row="0" Grid.Column="2" Columns="8" Rows="1" Height="22" Width="560">
                                <TextBlock Text="A" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="B" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="C" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="D" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="E" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="F" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="G" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="H" Style="{StaticResource BoardCoordinateStyle}"/>
                            </UniformGrid>

                            <!-- Left Rank Labels: 8 down to 1 (ONLY on Left) -->
                            <UniformGrid x:Name="gridRankLabels" Grid.Row="1" Grid.Column="1" Columns="1" Rows="8" Width="22" Height="560">
                                <TextBlock Text="8" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="7" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="6" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="5" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="4" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="3" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="2" Style="{StaticResource BoardCoordinateStyle}"/>
                                <TextBlock Text="1" Style="{StaticResource BoardCoordinateStyle}"/>
                            </UniformGrid>

                            <!-- Center: Chessboard Grid and Pause Overlay -->
                            <Border Grid.Row="1" Grid.Column="2" CornerRadius="4" ClipToBounds="True" BorderBrush="#2D2845" BorderThickness="1">
                                <Grid>
                                    <Grid x:Name="chessBoardGrid" Width="560" Height="560"
                                          RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Tactical Arrows Canvas -->
                                    <Canvas x:Name="arrowCanvas" Width="560" Height="560" IsHitTestVisible="False"/>

                                    <!-- Drag & Drop Floating Piece Canvas -->
                                    <Canvas x:Name="dragDropCanvas" Width="560" Height="560" IsHitTestVisible="False">
                                        <Image x:Name="imgDraggedPiece" Width="70" Height="70" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               RenderTransformOrigin="0.5,0.5"
                                               Visibility="Collapsed" IsHitTestVisible="False">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleX="1.22" ScaleY="1.22"/>
                                            </Image.RenderTransform>
                                            <Image.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.8"/>
                                            </Image.Effect>
                                        </Image>
                                    </Canvas>

                                    <!-- Pause Overlay -->
                                    <Border x:Name="pnlPauseOverlay" Background="#E612111A" CornerRadius="4"
                                            Width="560" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⏸️" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="TRẬN ĐẤU ĐANG TẠM DỪNG" FontSize="20" FontWeight="ExtraBold"
                                                       Foreground="#FFD700" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="lblPauseCountdown" Text="Thời gian tạm dừng còn lại: 02:00"
                                                       FontSize="15" Foreground="White" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,10,0,20"/>
                                            <Button x:Name="btnResumeGame" Content="▶️ Tiếp Tục Trận Đấu" Width="180" Height="44"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Background="#00E676" Foreground="#121212" FontWeight="Bold" FontSize="15"
                                                    Click="BtnResumeGame_Click">
                                                <Button.Effect>
                                                    <DropShadowEffect Color="#00E676" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                                </Button.Effect>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Right: Move History & Controls Panel -->
            <Border Grid.Column="1" Background="#2A2744" CornerRadius="12" Margin="16,0,0,0" Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📜 LỊCH SỬ NƯỚC ĐI" FontSize="16" FontWeight="ExtraBold"
                                   Foreground="#00E5FF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblMoveCount" Text="0 nước" Foreground="#A5A2C2" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Stockfish Move Evaluation & Analysis Panel (Offline vs Bot Mode) -->
                    <Border x:Name="pnlStockfishAnalysis" Grid.Row="1" Background="#1D1A2E" CornerRadius="10" Padding="10,8" Margin="0,0,0,8"
                            BorderBrush="#3D385E" BorderThickness="1.5" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Stockfish Engine + Hint Button + Toggle Button -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="13" Margin="0,0,4,0"/>
                                    <TextBlock Text="ĐÁNH GIÁ STOCKFISH" FontWeight="ExtraBold" FontSize="12" Foreground="#00E5FF"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Hint Button -->
                                    <Button x:Name="btnStockfishHint" Content="💡 Gợi ý" Height="24" Padding="7,0" Margin="0,0,6,0"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#373456" Foreground="#FFD700" FontWeight="Bold" FontSize="11"
                                            ToolTip="Xem gợi ý nước đi tốt nhất từ Stockfish"
                                            Click="BtnStockfishHint_Click"/>

                                    <!-- Toggle Eval Button -->
                                    <Button x:Name="btnToggleEval" Content="BẬT" Height="24" Padding="7,0"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#00E676" Foreground="#121212" FontWeight="Bold" FontSize="11"
                                            ToolTip="Bật/Tắt chế độ đánh giá nước đi của Stockfish"
                                            Click="BtnToggleEval_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Row 1: Overall Position Advantage -->
                            <Border Grid.Row="1" Background="#26233B" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock x:Name="lblStockfishPositionEval" Text="⚖️ Thế trận: Cân bằng (0.0)"
                                               Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblStockfishDepth" Text="Độ sâu: 14" Foreground="#8A87A6" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Row 2: Stockfish Move Commentary & Evaluation Card -->
                            <Border x:Name="borderLastMoveEval" Grid.Row="2" Background="#161424" CornerRadius="8" Padding="10,8" BorderBrush="#373456" BorderThickness="1.5">
                                <StackPanel>
                                    <!-- Header: Player / Move Info + Badge -->
                                    <DockPanel Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💬" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblLastMovePlayer" Text="Bình luận nước đi:" Foreground="#A5A2C2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button x:Name="btnToggleTts" Content="🔊" Width="24" Height="20" Margin="8,0,0,0" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Foreground="#00E5FF" FontSize="11" Cursor="Hand"
                                                    ToolTip="Bật/Tắt giọng đọc bình luận (TTS)" Click="BtnToggleTts_Click"/>
                                        </StackPanel>
                                        <Border x:Name="badgeLastMoveEval" Background="#00E676" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="lblLastMoveBadge" Text="⭐ Nước tốt nhất" Foreground="#121212" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Main Commentary Box -->
                                    <Border Background="#201D33" CornerRadius="6" Padding="8,6" BorderBrush="#302C48" BorderThickness="1">
                                        <TextBlock x:Name="lblLastMoveDetail" 
                                                   Text="Ván đấu vừa bắt đầu. Stockfish sẽ đưa ra bình luận chi tiết sau mỗi nước đi!"
                                                   Foreground="#E2E8F0" FontSize="11.5" LineHeight="16" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Best Alternative Suggestion Box (for Inaccuracy, Mistake, Blunder) -->
                                    <Border x:Name="pnlBestAltBox" Background="#281A24" CornerRadius="6" Padding="8,5" Margin="0,6,0,0" 
                                            BorderBrush="#5E2A38" BorderThickness="1" Visibility="Collapsed" Cursor="Hand"
                                            ToolTip="Bấm để xem gợi ý nước đi tối ưu trên bàn cờ"
                                            MouseLeftButtonUp="PnlBestAltBox_Click">
                                        <DockPanel>
                                            <TextBlock Text="💡 Gợi ý Stockfish:" Foreground="#FF8A80" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblBestAlternativeMove" Text="♘f3" Foreground="#FFD54F" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblBestAlternativeExplain" Text="" Foreground="#CBD5E1" FontSize="11" Margin="6,0,0,0" 
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Table Column Headers -->
                    <Border Grid.Row="2" Background="#222035" CornerRadius="6" Padding="6,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="colHdrTime" Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Foreground="#A5A2C2" FontWeight="Bold" FontSize="12"/>
                            
                            <!-- White Column Header with King icon -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="imgHdrWhiteKing" Width="18" Height="18" Margin="0,0,4,0"/>
                                <TextBlock Text="Quân Trắng" Foreground="White" FontWeight="Normal" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Black Column Header with King icon -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="imgHdrBlackKing" Width="18" Height="18" Margin="0,0,4,0"/>
                                <TextBlock Text="Quân Đen" Foreground="White" FontWeight="Normal" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="lblHdrTime" Grid.Column="3" Text="Thời Gian" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Move History Scroll Area -->
                    <Border Grid.Row="3" Background="#1E1C2E" CornerRadius="8" Padding="6">
                        <ScrollViewer x:Name="scrollMoveHistory" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="pnlMoveHistory"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Action Buttons: Xin Hoà, Đầu Hàng, Xin Tạm Dừng (Only in PvP mode) -->
                    <Grid x:Name="pnlPvPActionButtons" Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Offer Draw -->
                        <Button x:Name="btnOfferDraw" Grid.Column="0" Content="🤝 Xin Hoà" Height="40" Margin="0,0,6,0"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#54507A" Foreground="White" FontWeight="Bold" FontSize="13"
                                Click="BtnOfferDraw_Click"/>

                        <!-- Resign / Surrender -->
                        <Button x:Name="btnResign" Grid.Column="1" Content="🏳️ Đầu Hàng" Height="40" Margin="0,0,6,0"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#8B2626" Foreground="White" FontWeight="Bold" FontSize="13"
                                Click="BtnResign_Click"/>

                        <!-- Pause Game -->
                        <Button x:Name="btnPause" Grid.Column="2" Content="⏸️ Tạm Dừng" Height="40"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#373456" Foreground="#FFD700" FontWeight="Bold" FontSize="13"
                                Click="BtnPause_Click"/>
                    </Grid>

                    <!-- Action Button for Bot Mode: Thoát -->
                    <Button x:Name="btnBotExit" Grid.Row="4" Margin="0,12,0,0" Content="🚪 Thoát Ván Đấu" Height="40"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#B43232" Foreground="White" FontWeight="Bold" FontSize="14"
                            Click="BtnLeave_Click" Visibility="Collapsed"/>

                    <!-- Action Controls for Custom Room & Replay Mode (4 Navigation / Playback Buttons + Stockfish Hint) -->
                    <StackPanel x:Name="pnlReplayCustomControls" Grid.Row="4" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Quay lại nước đi trước -->
                            <Button x:Name="btnReplayPrev" Grid.Column="0" Height="44" Margin="0,0,5,0"
                                    ToolTip="Quay lại nước đi trước"
                                    Background="#EAE6DF" BorderThickness="0" Cursor="Hand"
                                    Click="BtnReplayPrev_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">
                                            <Image Source="/assets/textures/replay_prev.png" Stretch="Uniform"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 2. Tiếp / Phát từ đầu (Auto 1.25s) -->
                            <Button x:Name="btnReplayPlay" Grid.Column="1" Height="44" Margin="0,0,5,0"
                                    ToolTip="Tiếp tục phát tự động (mỗi 1.25s) / Phát lại từ đầu"
                                    Background="#EAE6DF" BorderThickness="0" Cursor="Hand"
                                    Click="BtnReplayPlay_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">
                                            <Image Source="/assets/textures/replay_play.png" Stretch="Uniform"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 3. Tạm dừng -->
                            <Button x:Name="btnReplayPause" Grid.Column="2" Height="44" Margin="0,0,5,0"
                                    ToolTip="Tạm dừng phát"
                                    Background="#EAE6DF" BorderThickness="0" Cursor="Hand"
                                    Click="BtnReplayPause_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">
                                            <Image Source="/assets/textures/replay_pause.png" Stretch="Uniform"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 4. Nước đi sau / Nước đi hiện tại -->
                            <Button x:Name="btnReplayNext" Grid.Column="3" Height="44"
                                    ToolTip="Nước đi sau / Nước đi hiện tại"
                                    Background="#EAE6DF" BorderThickness="0" Cursor="Hand"
                                    Click="BtnReplayNext_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">
                                            <Image Source="/assets/textures/replay_next.png" Stretch="Uniform"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Custom Mode Stockfish Move Suggestion -->
                        <Button x:Name="btnCustomStockfishHint" Margin="0,8,0,0" Height="38"
                                Content="💡 Gợi ý nước đi tiếp (Stockfish)"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#373456" Foreground="#FFD700" FontWeight="Bold" FontSize="13"
                                ToolTip="Stockfish gợi ý nước đi tốt nhất tiếp theo cho lượt hiện tại (Phím tắt: H)"
                                Click="BtnStockfishHint_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Controls -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="lblStatusTip" Text="Chọn quân cờ hoặc kéo thả để di chuyển" Foreground="#A5A2C2" FontSize="13" VerticalAlignment="Center"/>
            <Button x:Name="btnLeave" Content="🚪 Rời Trận" Width="110" Height="34"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#B43232" Foreground="White"
                    Click="BtnLeave_Click"/>
        </DockPanel>
    </Grid>
</Window>