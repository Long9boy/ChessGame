<Window x:Class="ChessGame_PJ.Views.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng Xếp Hạng" Height="600" Width="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/assets/app_icon.png"
        Background="#1E1C2E">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🏆 BẢNG XẾP HẠNG CAO THỦ"
                       FontSize="20" FontWeight="ExtraBold"
                       Foreground="#FFD700"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
        </DockPanel>

        <!-- Category Tabs -->
        <Border Grid.Row="1" Background="#242238" CornerRadius="10" Padding="4" Margin="0,0,0,10">
            <UniformGrid Columns="5" Rows="1">
                <Button x:Name="btnTabElo" Content="⭐ Top ELO" Height="34" Margin="2"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#00E5FF" Foreground="#121212" FontWeight="Bold" FontSize="13"
                        Click="BtnTabElo_Click"/>
                <Button x:Name="btnTabEasy" Content="🟢 Thắng Dễ" Height="34" Margin="2"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#373456" Foreground="White" FontWeight="Bold" FontSize="13"
                        Click="BtnTabEasy_Click"/>
                <Button x:Name="btnTabMedium" Content="🟡 Thắng Thường" Height="34" Margin="2"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#373456" Foreground="White" FontWeight="Bold" FontSize="13"
                        Click="BtnTabMedium_Click"/>
                <Button x:Name="btnTabHard" Content="🔴 Thắng Khó" Height="34" Margin="2"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#373456" Foreground="White" FontWeight="Bold" FontSize="13"
                        Click="BtnTabHard_Click"/>
                <Button x:Name="btnTabStockfish" Content="👑 Stockfish" Height="34" Margin="2"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#373456" Foreground="White" FontWeight="Bold" FontSize="13"
                        Click="BtnTabStockfish_Click"/>
            </UniformGrid>
        </Border>

        <!-- Tab Description Bar -->
        <Border Grid.Row="2" Background="#1E1C2E" Margin="0,0,0,8" Padding="6,2">
            <DockPanel>
                <TextBlock x:Name="lblCategoryDesc" Text="Top cao thủ tích luỹ điểm ELO qua các trận đấu ghép trận"
                           Foreground="#A5A2C2" FontSize="12" FontStyle="Italic" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblHeaderMetric" Text="Điểm ELO  •  Tỉ lệ thắng"
                           Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main Leaderboard List -->
        <Border Grid.Row="3" Background="#2A2744" CornerRadius="10" Padding="8">
            <Grid>
                <TextBlock x:Name="lblLoading" Text="Đang tải dữ liệu bảng xếp hạng..."
                           Foreground="#A5A2C2" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlList"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="4" Content="Đóng" Width="110" Height="36"
                HorizontalAlignment="Center" Margin="0,12,0,0"
                Style="{StaticResource ModernButtonStyle}"
                Background="#54507A"
                Click="BtnClose_Click"/>
    </Grid>
</Window>