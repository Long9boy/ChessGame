<Window x:Class="ChessGame_PJ.Views.MatchmakingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tìm Ghép Trận Đấu" Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1C2E">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Chơi xếp hạng"
                   FontSize="20" FontWeight="ExtraBold"
                   Foreground="#00E5FF" HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Search Status Box -->
        <Border Grid.Row="1" Background="#2A2744" CornerRadius="12" Margin="0,16,0,16" Padding="20"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚔️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                
                <TextBlock x:Name="lblStatus" Text="Đang tìm đối thủ phù hợp..."
                           FontSize="16" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="lblTimer" Text="Đang tìm trận: 00:00"
                           FontSize="14" Foreground="#FFD700" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,8,0,12"/>
            </StackPanel>
        </Border>

        <!-- Cancel Button -->
        <Button Grid.Row="2" Content="Huỷ Tìm Trận" Width="140" Height="38"
                Style="{StaticResource ModernButtonStyle}"
                Background="#B43232" Foreground="White" FontWeight="Bold" FontSize="14"
                HorizontalAlignment="Center"
                Click="BtnCancel_Click"/>
    </Grid>
</Window>
