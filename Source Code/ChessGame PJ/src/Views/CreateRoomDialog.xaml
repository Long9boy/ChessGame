<Window x:Class="ChessGame_PJ.Views.CreateRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Phòng Mới" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/assets/app_icon.png"
        Background="#1E1C2E">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="➕ TẠO PHÒNG GIAO HỮU"
                   FontSize="20" FontWeight="ExtraBold"
                   Foreground="#00E676" HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="#00E676" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Room Type & Settings options -->
        <Border Grid.Row="1" Background="#2A2744" CornerRadius="12" Margin="0,12,0,12" Padding="16">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Chọn chế độ phòng:" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                
                <RadioButton x:Name="rbModeOnline" IsChecked="True" GroupName="RoomType" Margin="0,2,0,4" Cursor="Hand" Checked="RbMode_Checked">
                    <RadioButton.Content>
                        <TextBlock Text="👥 Phòng Online (2 người chơi giao hữu)" Foreground="#00E5FF" FontWeight="Bold" FontSize="13"/>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="rbModeCustom" GroupName="RoomType" Margin="0,2,0,10" Cursor="Hand" Checked="RbMode_Checked">
                    <RadioButton.Content>
                        <TextBlock Text="🛠️ Phòng Custom (1 người chơi - Điều khiển 2 bên)" Foreground="#FFD700" FontWeight="Bold" FontSize="13"/>
                    </RadioButton.Content>
                </RadioButton>

                <Border Height="1" Background="#3D3960" Margin="0,4,0,10"/>

                <!-- Time options panel (only for online room) -->
                <StackPanel x:Name="pnlTimeOptions">
                    <TextBlock Text="Tổng thời gian mỗi bên:" Foreground="#A5A2C2" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>

                    <RadioButton x:Name="rb10m" IsChecked="True" GroupName="RoomTime" Margin="0,2,0,2" Cursor="Hand">
                        <RadioButton.Content>
                            <TextBlock Text="⏱️ 10 Phút (Tiêu chuẩn)" Foreground="#00E5FF" FontWeight="Bold" FontSize="13"/>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton x:Name="rb15m" GroupName="RoomTime" Margin="0,2,0,2" Cursor="Hand">
                        <RadioButton.Content>
                            <TextBlock Text="⏱️ 15 Phút" Foreground="#FFD700" FontWeight="Bold" FontSize="13"/>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton x:Name="rb20m" GroupName="RoomTime" Margin="0,2,0,2" Cursor="Hand">
                        <RadioButton.Content>
                            <TextBlock Text="⏱️ 20 Phút" Foreground="#00E676" FontWeight="Bold" FontSize="13"/>
                        </RadioButton.Content>
                    </RadioButton>
                </StackPanel>

                <!-- Move Hints Option -->
                <Border Background="#211E36" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <CheckBox x:Name="chkMoveHints" IsChecked="True" Cursor="Hand">
                        <CheckBox.Content>
                            <TextBlock Text="💡 Gợi ý nước đi" Foreground="#00E5FF" FontWeight="Bold" FontSize="13"/>
                        </CheckBox.Content>
                    </CheckBox>
                </Border>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="2">
            <Button Content="Huỷ" Width="100" Height="38"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#54507A" Foreground="White"
                    Click="BtnCancel_Click"/>
            <Button Content="Tạo Phòng Ngay" Width="160" Height="38"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#00E676" Foreground="#121212" FontWeight="Bold" FontSize="14"
                    Click="BtnCreate_Click"/>
        </DockPanel>
    </Grid>
</Window>

